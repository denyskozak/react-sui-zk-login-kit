{
  "name": "react-sui-zk-login-kit",
  "version": "1.1.12",
  "type": "module",
  "description": "A React kit for SUI zk login integration with components and hooks.",
  "repository": {
    "type": "git",
    "url": "https://github.com/denyskozak/react-sui-zk-login-kit"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-dist.mjs",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "publish-to-npm": "npm run build && npm publish --access public",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "react hooks",
    "sui",
    "sui components",
    "zk-login",
    "zk login",
    "zklogin",
    "sui zklogin",
    "sui zk-login",
    "web3",
    "web3 login",
    "authentication",
    "auth hooks",
    "react components",
    "decentralized login",
    "blockchain authentication",
    "zero knowledge",
    "zero knowledge login",
    "zero knowledge authentication",
    "sui blockchain",
    "react sui",
    "login components"
  ],
  "author": "DKozak denys.kozak.self@gmail.com",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@mysten/sui": "^2.33.1",
    "axios": "^1.20.0",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
